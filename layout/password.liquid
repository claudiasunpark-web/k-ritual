<!doctype html>
<html lang="{{ request.locale.iso_code }}">
  <head>
    <meta charset="utf-8">
    <meta name="viewport" content="width=device-width,initial-scale=1">
    <title>{{ shop.name }}</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family={{ settings.font_heading }}:wght@400;600;700&family={{ settings.font_body }}:wght@400;500;700&display=swap" rel="stylesheet">
    {{ content_for_header }}
    <style>
      :root {
        --color-bg: {{ settings.color_background }};
        --color-surface: {{ settings.color_surface }};
        --color-text: {{ settings.color_text }};
        --color-muted: {{ settings.color_text | color_mix: settings.color_background, 65 }};
        --color-border: {{ settings.color_text | color_mix: settings.color_background, 15 }};
        --color-accent: {{ settings.color_accent }};
        --color-accent-text: {{ settings.color_accent_text }};
        --font-heading: '{{ settings.font_heading | replace: '+', ' ' }}', 'Noto Serif KR', Georgia, serif;
        --font-body: '{{ settings.font_body | replace: '+', ' ' }}', 'Noto Sans KR', -apple-system, BlinkMacSystemFont, sans-serif;
        --radius: {{ settings.corner_radius }}px;
        --page-width: {{ settings.page_width }}px;
      }
    </style>
    {{ 'base.css' | asset_url | stylesheet_tag }}
  </head>
  <body class="template-password">
    <main id="MainContent">{{ content_for_layout }}</main>
  </body>
</html>
