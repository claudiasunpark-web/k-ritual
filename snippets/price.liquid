{%- comment -%}
  Accepts: product, variant (optional)
{%- endcomment -%}
{%- liquid
  assign target = variant | default: product.selected_or_first_available_variant
  if variant == blank and product.price_varies
    assign show_from = true
  endif
-%}
<span class="price{% if target.compare_at_price > target.price %} price--sale{% endif %}" data-price>
  {%- if show_from -%}
    {%- assign price_min = product.price_min | money -%}
    {{ 'courses.from_price' | t: price: price_min }}
  {%- else -%}
    {%- if target.compare_at_price > target.price -%}
      <s class="price__compare">{{ target.compare_at_price | money }}</s>
    {%- endif -%}
    <span class="price__current">{{ target.price | money }}</span>
  {%- endif -%}
</span>
