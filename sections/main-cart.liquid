<section class="section">
  <div class="page-width page-width--narrow">
    <div class="page-header"><h1>{{ 'cart.title' | t }}</h1></div>

    {%- if cart.item_count > 0 -%}
      <form action="{{ routes.cart_url }}" method="post" class="cart" novalidate>
        <ul class="cart__items">
          {%- for item in cart.items -%}
            <li class="cart-item">
              <a href="{{ item.url }}" class="cart-item__media">
                {%- if item.image -%}
                  {{ item.image | image_url: width: 240 | image_tag: loading: 'lazy', alt: item.product.title }}
                {%- endif -%}
              </a>
              <div class="cart-item__details">
                <a href="{{ item.url }}" class="cart-item__title">{{ item.product.title | escape }}</a>
                {%- unless item.product.has_only_default_variant -%}
                  <p class="cart-item__variant">{% render 'icon', name: 'calendar' %}{{ item.variant.title | escape }}</p>
                {%- endunless -%}
                {%- for property in item.properties -%}
                  {%- unless property.last == blank or property.first contains '_' -%}
                    <p class="cart-item__variant">{{ property.first }}: {{ property.last }}</p>
                  {%- endunless -%}
                {%- endfor -%}
                <div class="cart-item__actions">
                  <label class="visually-hidden" for="Qty-{{ item.key }}">{{ 'courses.quantity' | t }}</label>
                  <input id="Qty-{{ item.key }}" type="number" name="updates[]" value="{{ item.quantity }}" min="0" data-auto-submit>
                  <a href="{{ item.url_to_remove }}" class="text-link">{{ 'cart.remove' | t }}</a>
                </div>
              </div>
              <div class="cart-item__price">
                {%- if item.original_line_price > item.final_line_price -%}<s>{{ item.original_line_price | money }}</s>{%- endif -%}
                {{ item.final_line_price | money }}
              </div>
            </li>
          {%- endfor -%}
        </ul>

        {%- if section.settings.show_note -%}
          <div class="field">
            <label for="CartNote">{{ 'cart.note' | t }}</label>
            <textarea id="CartNote" name="note" rows="3">{{ cart.note }}</textarea>
          </div>
        {%- endif -%}

        <div class="cart__summary">
          <div class="cart__total">
            <span>{{ 'cart.subtotal' | t }}</span>
            <strong>{{ cart.total_price | money_with_currency }}</strong>
          </div>
          <p class="cart__note">{{ 'cart.taxes_note' | t }}</p>
          <div class="button-row">
            <button type="submit" name="update" class="button button--secondary no-js-only">{{ 'cart.update' | t }}</button>
            <button type="submit" name="checkout" class="button">{{ 'cart.checkout' | t }}</button>
          </div>
          {%- if additional_checkout_buttons -%}
            <div class="cart__dynamic-checkout">{{ content_for_additional_checkout_buttons }}</div>
          {%- endif -%}
        </div>
      </form>
    {%- else -%}
      <div class="empty-state">
        <p>{{ 'cart.empty' | t }}</p>
        <a href="{{ routes.all_products_collection_url }}" class="button">{{ 'cart.continue' | t }}</a>
      </div>
    {%- endif -%}
  </div>
</section>

{% schema %}
{
  "name": "장바구니",
  "settings": [
    { "type": "checkbox", "id": "show_note", "label": "강사에게 메모 남기기 칸 표시", "default": true }
  ]
}
{% endschema %}
