<section class="section section--{{ section.settings.background }}">
  <div class="page-width">
    <div class="section-heading section-heading--center">
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        <h2>{{ section.settings.heading | escape }}</h2>
      </div>
    </div>
    <div class="feature-grid">
      {%- for block in section.blocks -%}
        <div class="feature" {{ block.shopify_attributes }}>
          {%- if block.settings.image != blank -%}
            {{ block.settings.image | image_url: width: 160 | image_tag: loading: 'lazy', class: 'feature__image' }}
          {%- else -%}
            <span class="feature__number">{{ forloop.index | prepend: '0' | slice: -2, 2 }}</span>
          {%- endif -%}
          <h3>{{ block.settings.title | escape }}</h3>
          <div class="rte">{{ block.settings.text }}</div>
        </div>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "특징 / 수강 혜택",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "상단 작은 글씨", "default": "Why learn with us" },
    { "type": "text", "id": "heading", "label": "제목", "default": "Classes designed for real practice" },
    { "type": "select", "id": "background", "label": "배경", "default": "surface", "options": [
      { "value": "default", "label": "기본" }, { "value": "surface", "label": "강조" }
    ] }
  ],
  "blocks": [
    {
      "type": "feature",
      "name": "항목",
      "settings": [
        { "type": "image_picker", "id": "image", "label": "아이콘 이미지 (선택)" },
        { "type": "text", "id": "title", "label": "제목", "default": "Small groups" },
        { "type": "richtext", "id": "text", "label": "설명", "default": "<p>Every session is capped so you get personal feedback.</p>" }
      ]
    }
  ],
  "max_blocks": 6,
  "presets": [{
    "name": "특징 / 수강 혜택",
    "blocks": [
      { "type": "feature", "settings": { "title": "Small groups", "text": "<p>Max 12 students per session, so you get personal feedback.</p>" } },
      { "type": "feature", "settings": { "title": "All materials included", "text": "<p>Tools and ingredients are ready for you when you arrive.</p>" } },
      { "type": "feature", "settings": { "title": "Take-home guide", "text": "<p>Keep practicing with a printed guide and video recap.</p>" } }
    ]
  }]
}
{% endschema %}
