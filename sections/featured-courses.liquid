{%- liquid
  assign source = section.settings.collection
  if source == blank
    assign source = collections.all
  endif
  assign limit = section.settings.limit
-%}
<section class="section section--{{ section.settings.background }}">
  <div class="page-width">
    <div class="section-heading">
      <div>
        {%- if section.settings.eyebrow != blank -%}<p class="eyebrow">{{ section.settings.eyebrow | escape }}</p>{%- endif -%}
        <h2>{{ section.settings.heading | escape }}</h2>
      </div>
      {%- if section.settings.show_view_all and source.products_count > limit -%}
        <a href="{{ source.url }}" class="text-link">{{ 'general.view_all' | t }} →</a>
      {%- endif -%}
    </div>

    <div class="course-grid course-grid--{{ section.settings.columns }}">
      {%- for product in source.products limit: limit -%}
        {% render 'course-card', product: product %}
      {%- else -%}
        {%- for i in (1..3) -%}
          {% render 'course-card', product: blank %}
        {%- endfor -%}
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "클래스 목록",
  "settings": [
    { "type": "text", "id": "eyebrow", "label": "상단 작은 글씨", "default": "Upcoming" },
    { "type": "text", "id": "heading", "label": "제목", "default": "Upcoming classes" },
    { "type": "collection", "id": "collection", "label": "보여줄 컬렉션 (비워두면 전체)" },
    { "type": "range", "id": "limit", "label": "최대 개수", "min": 2, "max": 12, "step": 1, "default": 6 },
    { "type": "select", "id": "columns", "label": "한 줄 개수 (데스크톱)", "default": "3", "options": [
      { "value": "2", "label": "2" }, { "value": "3", "label": "3" }, { "value": "4", "label": "4" }
    ] },
    { "type": "checkbox", "id": "show_view_all", "label": "'전체 보기' 링크 표시", "default": true },
    { "type": "select", "id": "background", "label": "배경", "default": "default", "options": [
      { "value": "default", "label": "기본" }, { "value": "surface", "label": "강조" }
    ] }
  ],
  "presets": [{ "name": "클래스 목록" }]
}
{% endschema %}
