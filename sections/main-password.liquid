<section class="section password">
  <div class="page-width page-width--narrow text-center">
    <p class="eyebrow">{{ shop.name }}</p>
    <h1>{{ section.settings.heading | escape }}</h1>
    {%- if shop.password_message != blank -%}<p>{{ shop.password_message }}</p>{%- endif -%}

    {%- form 'customer', class: 'newsletter-form' -%}
      <input type="hidden" name="contact[tags]" value="prospect,password page">
      {%- if form.posted_successfully? -%}
        <p class="form-success">{{ 'newsletter.success' | t }}</p>
      {%- else -%}
        <div class="inline-field">
          <label class="visually-hidden" for="PasswordNewsletter">{{ 'newsletter.email' | t }}</label>
          <input id="PasswordNewsletter" type="email" name="contact[email]" required placeholder="{{ 'newsletter.email' | t }}">
          <button type="submit" class="button">{{ 'newsletter.subscribe' | t }}</button>
        </div>
      {%- endif -%}
    {%- endform -%}

    <details class="password__login">
      <summary>Store owner? Enter password</summary>
      {%- form 'storefront_password' -%}
        {%- if form.errors -%}<p class="form-error">{{ form.errors | default_errors }}</p>{%- endif -%}
        <div class="inline-field">
          <label class="visually-hidden" for="StorePassword">Password</label>
          <input id="StorePassword" type="password" name="password" autocomplete="current-password" placeholder="Password">
          <button type="submit" class="button button--secondary">Enter</button>
        </div>
      {%- endform -%}
    </details>
  </div>
</section>

{% schema %}
{
  "name": "오픈 준비중 페이지",
  "settings": [
    { "type": "text", "id": "heading", "label": "제목", "default": "Classes opening soon" }
  ]
}
{% endschema %}
