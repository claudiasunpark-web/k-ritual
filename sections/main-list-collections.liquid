<section class="section">
  <div class="page-width">
    <div class="page-header"><h1>{{ section.settings.heading | escape }}</h1></div>
    <div class="collection-grid">
      {%- for collection in collections -%}
        <a href="{{ collection.url }}" class="collection-tile">
          <div class="collection-tile__media">
            {%- if collection.featured_image -%}
              {{ collection.featured_image | image_url: width: 800 | image_tag: loading: 'lazy', widths: '400, 600, 800', sizes: '(min-width: 750px) 33vw, 100vw' }}
            {%- else -%}
              {{ 'collection-1' | placeholder_svg_tag: 'placeholder' }}
            {%- endif -%}
          </div>
          <span class="collection-tile__title">{{ collection.title | escape }} →</span>
        </a>
      {%- endfor -%}
    </div>
  </div>
</section>

{% schema %}
{
  "name": "카테고리 목록",
  "settings": [
    { "type": "text", "id": "heading", "label": "제목", "default": "All categories" }
  ]
}
{% endschema %}
